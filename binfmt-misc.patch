+                st = 1;
+                for (unsigned i = 0; i<phn; i++) if (*(u32*)(ph+phes*i) == 3) st = 0;
+            }
+        }
+    }
+    sc(N_close, fd, 0, 0, 0, 0, 0);
+    return st;
