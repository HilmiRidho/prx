+        if (bf_cmd("0\n", 2) != 0 || bf_cmd("1", 1) != 1 || bf_cmd("-1\n", 3) != 2 || bf_cmd("-1", 2) != 2 || bf_cmd("2", 1) != -1 || bf_cmd(":x:", 3) != -1) bad |= 4096;
+    }
+    /* live sync against a directory laid out like the one prx creates */
+    if (argc > 2) {
+        char p[PM];
+        char sb[64];
+        long n;
+        memcpy(g_bfdir, argv[2], strlen(argv[2])+1);
+        g_nbf = 0;
+        bf_path(p, "/fs/register", NULL);
+        bf_spit(p, ":a:M::XY::/bin/i:\n:b:E::zz::/bin/j:P\n", strlen(":a:M::XY::/bin/i:\n:b:E::zz::/bin/j:P\n"));
+        bf_sync();
+        if (g_nbf != 2 || bf_fsize(p) != 0) bad |= 8192;
+        bf_path(p, "/fs/a", NULL);
+        if (bf_slurp(p, sb, sizeof sb) < 10 || strncmp(sb, "enabled\ninterp", 14)) bad |= 8192;
+        bf_spit(p, "0\n", 2);
+        bf_sync();
+        if (g_nbf != 2 || g_bfr[0].enabled || bf_slurp(p, sb, sizeof sb) < 10 || strncmp(sb, "disabled\n", 9)) bad |= 16384;
+        bf_spit(p, "-1\n", 3);
+        bf_sync();
+        if (g_nbf != 1 || strcmp(g_bfr[0].name, "b") || bf_fsize(p) >= 0) bad |= 16384;
+        bf_path(p, "/fs/status", NULL);
+        bf_spit(p, "0", 1);
+        bf_sync();
+        if (g_bfst != 0 || (n = bf_slurp(p, sb, sizeof sb)) < 8 || strncmp(sb, "disabled\n", 9)) bad |= 16384;
+        bf_spit(p, "-1\n", 3);
+        bf_sync();
+        bf_path(p, "/fs/b", NULL);
+        if (g_nbf != 0 || bf_fsize(p) >= 0) bad |= 16384;
+        g_nbf = 0;
+        bf_db_load();
+        if (g_nbf != 0) bad |= 16384;                                 /* removal was persisted */
+    }
+
     printf("%d\n", bad);
     return bad ? 1 : 0;
 }
