#!/usr/bin/env bash
# prx - user-space container and path-translation engine
# SPDX-License-Identifier: Apache-2.0
PRX_VERSION=1.0.1
set -eu
# Data directory: $PRX_HOME if set; else legacy ~/.prx if it already exists
# (backward compatible); else the XDG location.
if [ -z "${PRX_HOME:-}" ]; then
if [ -d "$HOME/.prx" ]; then PRX_HOME="$HOME/.prx"
else PRX_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/prx"
fi
fi
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
SHIM="$PRX_HOME/lib/libprx.so"
die()  { echo "prx: error: $*" >&2; exit 1; }
warn() { echo "prx: warning: $*" >&2; }
info() { echo "prx: $*" >&2; }
chk() { case "$1" in ""|.|..|-*|*[!A-Za-z0-9._-]*) die "Invalid container name: '$1'" ;; esac; }
case "$(uname -m)" in
aarch64|arm64) TRIPLET=aarch64-linux-gnu; LDNAME=ld-linux-aarch64.so.1; ARCH=aarch64 ;;
x86_64|amd64)  TRIPLET=x86_64-linux-gnu;  LDNAME=ld-linux-x86-64.so.2;  ARCH=x86_64 ;;
*) die "Architecture $(uname -m) is not supported." ;;
esac
HARCH="$ARCH"
usage() {
cat <<EOF
prx - User-space container and path-translation engine

Usage:
  prx build                          Compile the C runtime shim and tools
  prx install NAME FILE|URL [--sha256 HEX]
                                     Install a glibc rootfs archive (optionally verified)
  prx login NAME [options] [-- cmd]  Execute shell or command inside guest rootfs
        -b, --bind PATH              Bind host path to identical path in guest
        -b, --bind HOST:GUEST        Bind host path to custom path inside guest
                                     (paths < 1024 bytes, no ':' or '=' inside, max 50 binds)
        -w, --workdir DIR            Initial working directory (default: /root)
        -e, --env KEY=VAL            Pass custom environment variable
        -c, --cpus N                 Limit CPU cores seen by the guest to N (0 = no limit)
        -m, --memory SIZE            Limit RAM seen by the guest, e.g. 512M, 2G (0 = no limit)
        --hard-mem                   With --memory: also enforce a hard cap (ulimit -v)
        --no-root-id                 Run as the host user (host name/UID/GID); sudo/su still work
        --trace                      Enable debug syscall & seccomp tracing
  prx set NAME [options]             Save default CPU/memory limits for a container
        -c, --cpus N                 Default CPU cores (0 = clear)
        -m, --memory SIZE            Default memory (0 = clear)
        --hard-mem | --no-hard-mem   Enable/disable hard memory cap by default
        --reset                      Clear all saved limits
        --show                       Show saved limits (default when no option given)
  prx list                           List all installed rootfs containers
  prx fixperm NAME                   Fix file permissions & clear cache
  prx remove NAME                    Completely remove a container
  prx source | prx ldsource          Print the C sources (shim / loader patcher)
  prx --version                      Show version

Environment:
  PRX_HOME=DIR      Data directory (default: ~/.prx if present, else \$XDG_DATA_HOME/prx)
  PRX_SRCDIR=DIR    Directory holding prx.c and ldpatch.c
  PRX_DNS=LIST      IPv4/IPv6 DNS servers for the guest (separated by ',', ';' or blanks)
  PRX_NO_ARGV0=1    Never pass --argv0 to the loader (auto-detected; glibc < 2.33 lacks it)
  CC=PROGRAM        C compiler used to build the shim

Cross-arch rootfs is detected automatically and run through qemu-user, in both
directions: x86_64 rootfs on an aarch64 host (needs qemu-x86_64) and aarch64 rootfs
on an x86_64 host (needs qemu-aarch64). To cross-build the shim you also need
clang + lld, or a cross gcc (aarch64-linux-gnu-gcc / x86_64-linux-gnu-gcc).
An i386 (32-bit x86) rootfs is supported on both host types, but only through
qemu-user (qemu-i386): there is no native i386 mode, even on an x86_64 host. Its
shim is built with clang + lld, i686-linux-gnu-gcc, or gcc -m32 (gcc-multilib).
  Termux:        pkg install qemu-user-x86-64 qemu-user-aarch64 qemu-user-i386 clang
  Debian/Ubuntu: apt install qemu-user-static clang lld
  PRX_QEMU=/path/to/qemu-ARCH        Use a specific qemu-user binary
  QEMU_CPU=max                       Extra QEMU_* variables are passed to qemu
EOF
}
prx_srcdir() {
local d
for d in "${PRX_SRCDIR:-}" "${SELF%/*}/../share/prx/src" "${SELF%/*}/src"; do
if [ -n "$d" ] && [ -f "$d/prx.c" ] && [ -f "$d/ldpatch.c" ]; then
(cd "$d" && pwd)
return 0
fi
done
return 1
}
need_src() { SRCDIR="$(prx_srcdir)" || die "C sources not found (set PRX_SRCDIR, or install with 'make install')"; }
shim_stale() {
[ -f "$1" ] || return 0
need_src
[ "$SELF" -nt "$1" ] || [ "$SRCDIR/prx.c" -nt "$1" ] || [ "$SRCDIR/ldpatch.c" -nt "$1" ]
}
cmd_source()   { need_src; cat "$SRCDIR/prx.c"; }
cmd_ldsource() { need_src; cat "$SRCDIR/ldpatch.c"; }
cmd_build() {
local cc="${CC:-}"
if [ -z "$cc" ]; then
if command -v clang >/dev/null 2>&1; then cc=clang
elif command -v gcc >/dev/null 2>&1; then cc=gcc
else die "Neither clang nor gcc compiler was found."
fi
fi
command -v "$cc" >/dev/null 2>&1 || die "Compiler '$cc' executable not found."
need_src
mkdir -p "$PRX_HOME/lib"
local extra="-Wl,-z,max-page-size=65536"
if "$cc" --version 2>/dev/null | grep -qi clang; then
# --pack-dyn-relocs is an lld-only option: use lld when present, else skip it
if command -v ld.lld >/dev/null 2>&1; then extra="$extra -fuse-ld=lld -Wl,--pack-dyn-relocs=none"; fi
[ "$ARCH" = aarch64 ] && extra="$extra -mbranch-protection=none"
fi
"$cc" -O2 -fPIC -shared -nostdlib -ffreestanding -fno-stack-protector \
-fno-builtin -Wl,-z,undefs -Wl,-soname,libprx.so $extra \
-o "$SHIM" "$SRCDIR/prx.c" || die "Failed to build shim: $SHIM"
info "Shim built successfully: $SHIM"
"$cc" -O2 -o "$PRX_HOME/lib/ldpatch" "$SRCDIR/ldpatch.c" || die "Failed to build ldpatch"
info "Loader patch tool built successfully: $PRX_HOME/lib/ldpatch"
}
set_arch() {
case "$1" in
aarch64) TRIPLET=aarch64-linux-gnu; LDNAME=ld-linux-aarch64.so.1; ARCH=aarch64 ;;
x86_64)  TRIPLET=x86_64-linux-gnu;  LDNAME=ld-linux-x86-64.so.2;  ARCH=x86_64 ;;
i386)    TRIPLET=i386-linux-gnu;    LDNAME=ld-linux.so.2;          ARCH=i386 ;;
esac
}
detect_guest() {
local r="$1" a
for a in "$HARCH" x86_64 aarch64 i386; do
set_arch "$a"
find_loader "$r" >/dev/null 2>&1 && return 0
done
set_arch "$HARCH"
return 1
}
find_qemu() {
local garch="$1" q
if [ -n "${PRX_QEMU:-}" ]; then
q="$PRX_QEMU"
[ -x "$q" ] || q="$(command -v "$q" 2>/dev/null || true)"
[ -n "$q" ] && [ -x "$q" ] && { readlink -f "$q" 2>/dev/null || echo "$q"; return 0; }
return 1
fi
for q in "qemu-$garch" "qemu-$garch-static"; do
if command -v "$q" >/dev/null 2>&1; then
command -v "$q"
return 0
fi
done
return 1
}
qemu_hint() {
local g="$1"
if [ -n "${TERMUX_VERSION:-}" ] || [ -d /data/data/com.termux ]; then echo "pkg install qemu-user-$(echo "$g" | tr _ -)"
elif command -v apt-get >/dev/null 2>&1; then echo "sudo apt install qemu-user-static"
elif command -v dnf >/dev/null 2>&1; then echo "sudo dnf install qemu-user-static"
elif command -v pacman >/dev/null 2>&1; then echo "sudo pacman -S qemu-user"
elif command -v apk >/dev/null 2>&1; then echo "apk add qemu-$g"
elif command -v zypper >/dev/null 2>&1; then echo "sudo zypper install qemu-linux-user"
else echo "install qemu-user for $g with your package manager"
fi
}
build_guest_shim() {
local garch="$1" out="$2" cc="${CC:-}" tgt extra tflag=""
case "$garch" in
x86_64) tgt=x86_64-linux-gnu ;;
aarch64) tgt=aarch64-linux-gnu ;;
i386) tgt=i686-linux-gnu ;;
*) die "Unsupported guest architecture: $garch" ;;
esac
if [ -z "$cc" ]; then
if command -v clang >/dev/null 2>&1; then cc=clang
elif command -v "$tgt-gcc" >/dev/null 2>&1; then cc="$tgt-gcc"
elif [ "$garch" = i386 ] && command -v gcc >/dev/null 2>&1 && echo 'int x;' | gcc -m32 -x c -c -o /dev/null - >/dev/null 2>&1; then cc=gcc
else die "Cross-compiling the shim for $garch needs clang+lld (Termux: pkg install clang; Debian/Ubuntu: apt install clang lld) or $tgt-gcc (Debian/Ubuntu: apt install gcc-$(echo "${tgt%%-*}" | tr _ -)-linux-gnu$([ "$garch" = i386 ] && echo ", or gcc-multilib for gcc -m32"))"
fi
fi
command -v "$cc" >/dev/null 2>&1 || die "Compiler '$cc' executable not found."
need_src
mkdir -p "$PRX_HOME/lib"
if "$cc" --version 2>/dev/null | grep -qi clang; then
extra="-fuse-ld=lld -Wl,-z,max-page-size=65536 -Wl,--pack-dyn-relocs=none"
tflag="--target=$tgt"
else
extra="-Wl,-z,max-page-size=65536"
# a plain (x86_64) gcc builds the 32-bit shim with -m32; an i686 cross gcc needs no flag
[ "$garch" = i386 ] && case "$cc" in *i[3-6]86-*) ;; *) tflag="-m32" ;; esac
fi
[ "$garch" = aarch64 ] && extra="$extra -mbranch-protection=none"
"$cc" ${tflag:+"$tflag"} -O2 -fPIC -shared -nostdlib -ffreestanding -fno-stack-protector \
-fno-builtin -Wl,-z,undefs -Wl,-soname,libprx.so $extra \
-o "$out" "$SRCDIR/prx.c" || die "Failed to cross-compile shim for $garch (CC=$cc must be able to target $garch; clang also needs lld)"
info "Guest shim built successfully: $out"
}
verify_sha256() {
local f="$1" want got
want="$(printf '%s' "$2" | tr 'A-F' 'a-f')"
case "$want" in ""|*[!0-9a-f]*) die "--sha256 must be a hex digest" ;; esac
[ "${#want}" = 64 ] || die "--sha256 must be exactly 64 hex characters"
if command -v sha256sum >/dev/null 2>&1; then got="$(sha256sum "$f" | cut -d' ' -f1)"
elif command -v shasum >/dev/null 2>&1; then got="$(shasum -a 256 "$f" | cut -d' ' -f1)"
else die "sha256sum/shasum not found; cannot verify the archive"
fi
[ "$got" = "$want" ] || die "SHA-256 mismatch for $f (expected $want, got $got)"
info "SHA-256 verified"
}
rootdir() { echo "$PRX_HOME/rootfs/$1"; }
# prx_session PID: set PRX_SESS to the PRX_SESSION value of a process ("-" if it
# has none). Pure bash, no fork per process (this runs for every entry of /proc).
prx_session() {
local e
PRX_SESS="-"
{ while IFS= read -r -d '' e; do
case "$e" in PRX_SESSION=*) PRX_SESS="${e#PRX_SESSION=}"; break ;; esac
done < "/proc/$1/environ"; } 2>/dev/null || true
}
prx_reap() {
[ "${PRX_KEEP:-0}" = 1 ] && return 0
local tok="${1:-}" rdir="${2:-}"
local p pid exe_link target_pids="" PRX_SESS="-"
trap '' TERM HUP INT
kill -TERM -$$ 2>/dev/null || true
for p in /proc/[0-9]*; do
pid="${p#/proc/}"
[ "$pid" = "$$" ] && continue
[ -r "$p/environ" ] || continue
prx_session "$pid"
if [ -n "$tok" ] && [ "$PRX_SESS" = "$tok" ]; then
target_pids="$target_pids $pid"
elif [ "$PRX_SESS" = "-" ] && [ -n "$rdir" ]; then
exe_link="$(readlink -f "$p/exe" 2>/dev/null || true)"
case "$exe_link" in
"$rdir"|"$rdir"/*) target_pids="$target_pids $pid" ;;
esac
fi
done
[ -z "$target_pids" ] && return 0
kill -TERM $target_pids 2>/dev/null || true
sleep 0.15
for pid in $target_pids; do
if [ -d "/proc/$pid" ]; then
kill -KILL "$pid" 2>/dev/null || true
fi
done
return 0
}
wfile() {
local f="$1"
mkdir -p "$(dirname "$f")"
rm -f "$f"
printf '%b' "$2" > "$f"
}
# rpath ROOT GUESTPATH [nofollow]
# Print the host path of GUESTPATH inside ROOT, resolving symbolic links as if
# ROOT were "/": absolute links stay inside ROOT and ".." cannot climb out of it.
# Every write into a rootfs goes through this, so a rootfs symlink such as
# /var/lib/dbus/machine-id -> /etc/machine-id can never redirect a write to the
# host. With "nofollow" the last component is not resolved.
rpath() {
local root="${1%/}" rest="$2" nf="${3:-}" cur="" comp link n=0
while :; do
rest="${rest#"${rest%%[!/]*}"}"
[ -n "$rest" ] || break
comp="${rest%%/*}"
if [ "$comp" = "$rest" ]; then rest=""; else rest="${rest#*/}"; fi
case "$comp" in
.) continue ;;
..) cur="${cur%/*}"; continue ;;
esac
if [ -L "$root$cur/$comp" ] && { [ -n "$rest" ] || [ "$nf" != nofollow ]; }; then
n=$((n+1))
if [ "$n" -gt 40 ]; then echo "prx: error: too many symbolic links in $2" >&2; return 1; fi
link="$(readlink "$root$cur/$comp")" || return 1
case "$link" in
/*) cur=""; rest="$link${rest:+/$rest}" ;;
*)  rest="$link${rest:+/$rest}" ;;
esac
else
cur="$cur/$comp"
fi
done
printf '%s\n' "$root$cur"
}
rwfile() {
local h
h="$(rpath "$1" "$2")" || exit 1
wfile "$h" "$3"
}
valid_ipv4() {
local re='^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$' i
[[ "$1" =~ $re ]] || return 1
for i in 1 2 3 4; do [ "$((10#${BASH_REMATCH[i]}))" -le 255 ] || return 1; done
return 0
}
# valid_ipv6 ADDR: RFC 4291 text form ("::" once, optional trailing dotted quad,
# no zone id).
valid_ipv6() {
local a="$1" pre="$1" post="" dbl=0 n=0 i part g vpart="" gi last
local -a gs
case "$a" in ""|*[!0-9a-fA-F:.]*|*:::*) return 1 ;; esac
case "$a" in *:*) ;; *) return 1 ;; esac
if [[ "$a" == *::* ]]; then
dbl=1; pre="${a%%::*}"; post="${a#*::}"
[[ "$post" == *::* ]] && return 1
fi
# the part that may end in an embedded IPv4 address
if [ -n "$post" ]; then vpart=1
elif [ "$dbl" = 0 ]; then vpart=0
fi
for i in 0 1; do
if [ "$i" = 0 ]; then part="$pre"; else part="$post"; fi
[ -z "$part" ] && continue
[[ "$part" == :* || "$part" == *: ]] && return 1
gs=(); IFS=: read -r -a gs <<<"$part"
last=$(( ${#gs[@]} - 1 )); gi=0
for g in "${gs[@]}"; do
if [[ "$g" == *.* ]]; then
{ [ "$vpart" = "$i" ] && [ "$gi" = "$last" ] && valid_ipv4 "$g"; } || return 1
n=$((n+2))
else
[[ "$g" =~ ^[0-9a-fA-F]{1,4}$ ]] || return 1
n=$((n+1))
fi
gi=$((gi+1))
done
done
if [ "$dbl" = 1 ]; then [ "$n" -le 7 ]; else [ "$n" -eq 8 ]; fi
}
# clean_dns LIST: keep only valid IPv4 / IPv6 addresses (separators: ',' ';' or
# blanks; a legacy ':'-separated list of IPv4 addresses is still understood).
# The result is comma-separated, which is also the format the shim expects.
clean_dns() {
local -a toks=() parts=()
local tok d out="" ok
read -r -a toks <<<"$(printf '%s' "$1" | tr ',;' '  ')"
for tok in ${toks[@]+"${toks[@]}"}; do
tok="${tok#[}"; tok="${tok%]}"
if valid_ipv4 "$tok" || valid_ipv6 "$tok"; then
out="${out:+$out,}$tok"
elif [[ "$tok" == *%* ]] && valid_ipv6 "${tok%%%*}"; then
warn "ignoring DNS server '$tok' (scoped/zone addresses are not supported)"
elif [[ "$tok" == *:* ]]; then
IFS=: read -r -a parts <<<"$tok"
ok=1
for d in "${parts[@]}"; do valid_ipv4 "$d" || ok=0; done
if [ "$ok" = 1 ]; then
for d in "${parts[@]}"; do out="${out:+$out,}$d"; done
else
warn "ignoring invalid DNS server '$tok'"
fi
else
warn "ignoring invalid DNS server '$tok'"
fi
done
echo "${out:-8.8.8.8,1.1.1.1}"
}
detect_dns() {
if [ -n "${PRX_DNS:-}" ]; then
clean_dns "$PRX_DNS"
return 0
fi
local d v4="" v6=""
# collect(): IPv4 servers go first so an IPv6-less host never waits on them
collect() {
case "$1" in
""|127.*|::1|0:0:0:0:0:0:0:1|*%*) ;;
*:*) v6="${v6:+$v6,}$1" ;;
*.*) v4="${v4:+$v4,}$1" ;;
esac
}
if command -v getprop >/dev/null 2>&1; then
for d in $(getprop net.dns1) $(getprop net.dns2) $(getprop net.dns3) $(getprop net.dns4); do
collect "$d"
done
fi
if [ -z "$v4$v6" ] && [ -r /etc/resolv.conf ]; then
while read -r _ d _; do
collect "$d"
done < <(grep '^nameserver' /etc/resolv.conf 2>/dev/null || true)
fi
clean_dns "${v4:+$v4${v6:+,}}${v6}"
}
find_loader() {
local r="$1" c
for c in \
"$r/usr/lib/$TRIPLET/$LDNAME" "$r/lib/$TRIPLET/$LDNAME" \
"$r/lib64/$LDNAME" "$r/usr/lib64/$LDNAME" \
"$r/lib/$LDNAME" "$r/usr/lib/$LDNAME" \
"$r/usr/lib64/$TRIPLET/$LDNAME" "$r/lib64/$TRIPLET/$LDNAME"; do
[ -e "$c" ] && { echo "$c"; return 0; }
done
return 1
}
find_shell() {
local r="$1" c target
for c in "$r/usr/bin/bash" "$r/bin/bash" "$r/usr/bin/sh" "$r/bin/sh" "$r/bin/ash"; do
if [ -e "$c" ] || [ -L "$c" ]; then
target="$c"
local hops=0
while [ -L "$target" ] && [ "$hops" -lt 40 ]; do
hops=$((hops+1))
local link; link="$(readlink "$target")"
case "$link" in
/*) target="$r$link" ;;
*)  target="$(dirname "$target")/$link" ;;
esac
done
[ -x "$target" ] && { echo "$c"; return 0; }
fi
done
return 1
}
cmd_install() {
[ $# -ge 2 ] || { usage; exit 1; }
local name="$1" src="$2" dest file sha=""
shift 2
while [ $# -gt 0 ]; do
case "$1" in
--sha256) [ $# -ge 2 ] || die "--sha256 requires a hex digest"; sha="$2"; shift 2 ;;
*) die "Unknown option for 'install': $1" ;;
esac
done
chk "$name"
dest="$(rootdir "$name")"
[ -e "$dest" ] && die "Rootfs '$name' already exists at $dest"
mkdir -p "$PRX_HOME/dl"
case "$src" in
http://*|https://*)
local base="${src%%\?*}"; base="${base%%#*}"; base="${base%/}"; base="${base##*/}"
case "$base" in ""|.|..) base="rootfs-$name.tar" ;; esac
file="$PRX_HOME/dl/$base"
command -v curl >/dev/null || die "curl not found"
info "Downloading $src ..."
curl -fL --retry 3 -o "$file" "$src" || die "Download failed"
;;
*) file="$src"; [ -f "$file" ] || die "File not found: $file" ;;
esac
if [ -n "$sha" ]; then verify_sha256 "$file" "$sha"
else warn "no --sha256 given: archive integrity and authenticity are not verified"
fi
mkdir -p "$dest"
info "Extracting rootfs to $dest ..."
local trc=0 terr
terr="$(mktemp "$PRX_HOME/dl/tar.err.XXXXXX")"
LC_ALL=C tar -xpf "$file" -C "$dest" --delay-directory-restore --no-same-owner \
--exclude='./dev/*' --exclude='dev/*' 2>"$terr" || trc=$?
if [ "$trc" -ne 0 ]; then
if grep -qiE 'unexpected eof|unexpected end of file|not in gzip format|does not look like a tar|no space left|not recoverable|child returned|corrupt|invalid magic|invalid tar header|file format not recognized' "$terr"; then
tail -n 5 "$terr" >&2
rm -f "$terr"
chmod -R u+rwX "$dest" 2>/dev/null || true
rm -rf "$dest"
die "Archive is corrupt or incomplete (tar exit status $trc)"
fi
warn "Archive extraction reported warnings (see $terr)"
fi
chmod -R u+rwX "$dest" 2>/dev/null || true
if [ "$trc" -ne 0 ] && grep -q 'Cannot hard link to' "$terr" 2>/dev/null; then
local nfix=0 hl ht tab; tab="$(printf '\t')"
while IFS="$tab" read -r hl ht; do
[ -n "$hl" ] && [ -n "$ht" ] || continue
local hh ht2
hh="$(rpath "$dest" "/$hl" nofollow 2>/dev/null)" && ht2="$(rpath "$dest" "/$ht" 2>/dev/null)" || continue
if [ ! -e "$hh" ] && [ -f "$ht2" ]; then
mkdir -p "$(dirname "$hh")" 2>/dev/null || true
cp -p "$ht2" "$hh" 2>/dev/null && nfix=$((nfix+1))
fi
done < <(sed -n "s/^tar: \(.*\): Cannot hard link to '\(.*\)': .*/\1$tab\2/p" "$terr")
[ "$nfix" -gt 0 ] && info "Hard links that could not be created were replaced by copies: $nfix"
fi
if [ ! -e "$dest/etc" ] && [ "$(ls -A "$dest" | wc -l)" = 1 ]; then
local sub; sub="$(ls -A "$dest")"
if [ -d "$dest/$sub/etc" ]; then
( shopt -s dotglob; mv "$dest/$sub"/* "$dest"/ 2>/dev/null || true )
rmdir "$dest/$sub" 2>/dev/null || true
fi
fi
[ -d "$dest/etc" ] || { rm -rf "$dest"; die "Target archive does not contain a standard Linux filesystem (missing /etc)"; }
local g
for g in /tmp /proc /sys /dev /root /home /run /var/tmp /etc/apt/apt.conf.d /usr/sbin /etc/sudoers.d /etc/pam.d; do
mkdir -p "$(rpath "$dest" "$g")"
done
chmod 1777 "$(rpath "$dest" /tmp)" "$(rpath "$dest" /var/tmp)"
chmod -R u+rwX "$(rpath "$dest" /etc/sudoers.d)" "$(rpath "$dest" /etc/pam.d)"
local cur_dns; cur_dns="$(detect_dns)"
local resolv_str="" d
for d in $(echo "$cur_dns" | tr ',' ' '); do
resolv_str="${resolv_str}nameserver $d\n"
done
rwfile "$dest" /etc/resolv.conf "$resolv_str"
[ -s "$(rpath "$dest" /etc/hosts)" ] || rwfile "$dest" /etc/hosts '127.0.0.1 localhost\n::1 localhost\n'
rwfile "$dest" /etc/apt/apt.conf.d/99prx 'APT::Sandbox::User "root";\nDir::Log::Terminal "";\n'
rwfile "$dest" /usr/sbin/policy-rc.d '#!/bin/sh\nexit 101\n'; chmod +x "$(rpath "$dest" /usr/sbin/policy-rc.d)"
for g in /sbin/ldconfig /usr/sbin/ldconfig /usr/bin/ldconfig /bin/ldconfig; do
l="$(rpath "$dest" "$g" nofollow)"
if [ -f "$l" ] && [ ! -L "$l" ] && [ ! -e "$l.REAL" ]; then
mv "$l" "$l.REAL"; printf '#!/bin/sh\nexit 0\n' > "$l"; chmod +x "$l"
fi
done
[ "$trc" -ne 0 ] || rm -f "$terr"
info "Installation complete. Enter container using: prx login $name"
}
lp_add() {
if [ $(( ${#LP} + ${#1} + 1 )) -gt 60000 ]; then
[ "${LP_WARNED:-0}" = 1 ] || { warn "Library path is too long; some directories were omitted"; LP_WARNED=1; }
return 0
fi
LP="$LP:$1"
}
prx_addmember() {
local f="$1" g="$2" m="$3" tmp="$1.prx.$$" line list
{
while IFS= read -r line || [ -n "$line" ]; do
case "$line" in
"$g":*)
list="${line##*:}"
case ",$list," in
*",$m,"*) ;;
*) if [ -n "$list" ]; then line="$line,$m"; else line="$line$m"; fi ;;
esac ;;
esac
printf '%s\n' "$line"
done < "$f"
} > "$tmp" && cat "$tmp" > "$f"
rm -f "$tmp"
}
prx_setup_user() {
