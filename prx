fi
chmod 755 "$H" 2>/dev/null || true
for f in usr/bin/sudo usr/bin/su usr/bin/passwd usr/bin/chsh usr/bin/chfn usr/bin/newgrp usr/bin/gpasswd; do
fh="$(rpath "$R" "/$f" nofollow)"
if [ -f "$fh" ] && [ ! -L "$fh" ]; then chmod u+s "$fh" 2>/dev/null || true; fi
done
