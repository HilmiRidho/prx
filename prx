host_cpus() {
local n=""
n="$(nproc 2>/dev/null)" || n=""
case "$n" in ""|*[!0-9]*|0) n="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)" || n="" ;; esac
case "$n" in ""|*[!0-9]*|0) n=1 ;; esac
echo "$n"
