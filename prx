parse_mem_kb() {
local s="$1" num unit kb
case "$s" in ""|*[!0-9A-Za-z]*) return 1 ;; esac
num="${s%%[!0-9]*}"
unit="${s#"$num"}"
[ -n "$num" ] && [ "${#num}" -le 12 ] || return 1
num=$((10#$num))
case "$unit" in
[kK]|[kK][bB]|[kK][iI][bB]) kb=$num ;;
""|[mM]|[mM][bB]|[mM][iI][bB]) kb=$((num*1024)) ;;
[gG]|[gG][bB]|[gG][iI][bB]) kb=$((num*1048576)) ;;
*) return 1 ;;
esac
