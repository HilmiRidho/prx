chmod u+rw "$P" "$G" 2>/dev/null || true
tmp="$P.prx.$$"
{
while IFS= read -r line || [ -n "$line" ]; do
n="${line%%:*}"; id1="${line#*:*:}"; id1="${id1%%:*}"
if [ "$n" != root ] && [ "$id1" != 0 ] && { [ "$n" = "$u" ] || [ "$id1" = "$uid" ]; }; then continue; fi
printf '%s\n' "$line"
done < "$P"
printf '%s:x:%s:%s:%s:/home/%s:/bin/bash\n' "$u" "$uid" "$gid" "$u" "$u"
} > "$tmp" && cat "$tmp" > "$P"
rm -f "$tmp"
while IFS= read -r line || [ -n "$line" ]; do
id1="${line#*:*:}"; id1="${id1%%:*}"
if [ "$id1" = "$gid" ]; then gline="$line"; break; fi
done < "$G"
if [ "$gid" != 0 ] && { [ -z "$gline" ] || [ "$gid" -ge 1000 ]; }; then
tmp="$G.prx.$$"
{
while IFS= read -r line || [ -n "$line" ]; do
n="${line%%:*}"; id1="${line#*:*:}"; id1="${id1%%:*}"
if [ "$id1" != 0 ] && { [ "$id1" = "$gid" ] || [ "$n" = "$u" ]; }; then continue; fi
printf '%s\n' "$line"
done < "$G"
printf '%s:x:%s:\n' "$u" "$gid"
