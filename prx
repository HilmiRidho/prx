chk_cpus() {
case "$1" in ""|*[!0-9]*) die "--cpus requires a positive integer (got '$1')" ;; esac
[ "${#1}" -le 5 ] && [ "$((10#$1))" -ge 1 ] && [ "$((10#$1))" -le 4096 ] || die "--cpus must be between 1 and 4096 (got '$1')"
