cpu_pick() {
local n="$1" allowed="" out="" cnt=0 part a b i
if [ -r /proc/self/status ]; then
allowed="$(sed -n 's/^Cpus_allowed_list:[[:space:]]*//p' /proc/self/status 2>/dev/null | head -n1)" || allowed=""
fi
[ -n "$allowed" ] || allowed="0-$(( $(host_cpus) - 1 ))"
local IFS=,
for part in $allowed; do
case "$part" in
*-*) a="${part%-*}"; b="${part#*-}" ;;
*) a="$part"; b="$part" ;;
esac
case "$a$b" in ""|*[!0-9]*) continue ;; esac
i=$a
while [ "$i" -le "$b" ] && [ "$cnt" -lt "$n" ]; do
out="${out:+$out,}$i"; cnt=$((cnt+1)); i=$((i+1))
done
[ "$cnt" -lt "$n" ] || break
done
echo "$out"
}
