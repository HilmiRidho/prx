[ -n "${COLORTERM:-}" ] && term_envs+=(COLORTERM="$COLORTERM")
local user_val="root" home_val="/root"
if [ "$fake" = 0 ]; then
user_val="$vuser"
home_val="$vhome"
fi
local cur_dns; cur_dns="$(detect_dns)"
if [ -n "$mem_kb" ] && [ "$hard" = 1 ]; then
ulimit -v "$mem_kb" 2>/dev/null || warn "Could not apply hard memory cap (ulimit -v)"
fi
local -a ldenv=() runner=() argv0opt=()
[ "$NOARGV0" = 1 ] || argv0opt=(--argv0 "$(basename "$gshell")")
if [ -n "$QEMU" ]; then
local qv
ldenv=(QEMU_SET_ENV="LD_PRELOAD=$SHIM,LD_LIBRARY_PATH=$LP" PRX_QEMU="$QEMU")
for qv in QEMU_CPU QEMU_STRACE QEMU_LOG QEMU_RESERVED_VA QEMU_GUEST_BASE QEMU_PAGESIZE; do
[ -n "${!qv:-}" ] && ldenv+=("$qv=${!qv}")
done
runner=("$QEMU")
else
ldenv=(LD_LIBRARY_PATH="$LP" LD_PRELOAD="$SHIM")
fi
${pin[@]+"${pin[@]}"} env -i \
HOME="$home_val" USER="$user_val" LOGNAME="$user_val" SHELL="$gshell" \
TERM="${TERM:-xterm-256color}" LANG="$LANGV" \
LOCPATH="$R/usr/lib/locale" GCONV_PATH="$GCONV" \
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
PRX_ROOTFS="$R" PRX_SHIM="$SHIM" PRX_LIBPATH="$LP" PRX_BIND="$binds" \
PRX_SESSION="$tok" PRX_SELF_EXE="$gshell" \
PRX_DNS="$cur_dns" PRX_FAKEROOT="$fake" PRX_VUSER="$vuser" \
PRX_TRACE="$trace" PRX_LOADER="$PL" PRX_NO_ARGV0="$NOARGV0" \
PRX_CPUS="${cpus:-0}" PRX_MEM_KB="${mem_kb:-0}" \
GLIBC_TUNABLES="${GLIBC_TUNABLES:-glibc.pthread.rseq=0}" \
${ldenv[@]+"${ldenv[@]}"} \
${term_envs[@]+"${term_envs[@]}"} \
${extra_envs[@]+"${extra_envs[@]}"} \
${runner[@]+"${runner[@]}"} "$LD" --library-path "$LP" ${argv0opt[@]+"${argv0opt[@]}"} "${prog[@]}" || rc=$?
trap - INT
kill "$watcher" 2>/dev/null || true
prx_reap "$tok"
exit "$rc"
}
cmd_fixperm() {
[ $# -ge 1 ] || { usage; exit 1; }
chk "$1"
local d; d="$(rootdir "$1")"; [ -d "$d" ] || die "Rootfs not found: $1"
chmod -R u+rwX "$d" 2>/dev/null || true
find "$d" -type d ! -perm -u+rwx -exec chmod u+rwx {} + 2>/dev/null || true
rm -f "$PRX_HOME/lib/libpath-$1"
info "Permissions reset and library cache flushed for $1"
}
cmd_list() {
if [ -d "$PRX_HOME/rootfs" ]; then
local found=0
for d in "$PRX_HOME/rootfs"/*; do
[ -d "$d" ] || continue
echo "${d##*/}"
found=1
done
[ "$found" = 1 ] || echo "(no rootfs installed yet)"
else
echo "(no rootfs installed yet)"
fi
}
cmd_remove() {
[ $# -ge 1 ] || { usage; exit 1; }
local name="$1" d; chk "$name"; d="$(rootdir "$name")"; [ -d "$d" ] || die "Rootfs not found: $name"
chmod -R u+rwX "$d" 2>/dev/null || true
rm -rf "$d"
rm -f "$PRX_HOME/lib/ld-$name.so" "$PRX_HOME/lib/ld-$name.so.stamp" "$PRX_HOME/lib/libpath-$name"
rm -rf "$PRX_HOME/lib/libc-$name"
rm -f "$PRX_HOME/conf/$name.conf"
info "Removed container '$name' and associated patches."
}
case "${1:-}" in
build) shift; cmd_build "$@" ;;
install) shift; cmd_install "$@" ;;
login) shift; cmd_login "$@" ;;
set) shift; cmd_set "$@" ;;
list) cmd_list ;;
fixperm) shift; cmd_fixperm "$@" ;;
remove) shift; cmd_remove "$@" ;;
source) cmd_source ;;
--version|-V|version) echo "prx $PRX_VERSION" ;;
ldsource) cmd_ldsource ;;
""|-h|--help|help) usage ;;
*) die "Unknown command '$1'. Run '$0 help' for usage." ;;
esac
exit 0
