+/* Decode one instruction. Returns 0 if its length is unknown (the translator ends the block before it). */
+static int jdecode(JI *j, u64 ip) {
+    memset(j, 0, sizeof *j);
+    const u8 *s = (const u8*) ip, *p = s;
