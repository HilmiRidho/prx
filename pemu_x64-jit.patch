+/* ------------------------------------------------------------ guest state access */
+static void c_ld(int rt, u32 off) { a_ldst_u(3, 1, rt, RCPU, off); }
+static void c_st(int rt, u32 off) { a_ldst_u(3, 0, rt, RCPU, off); }
+static void g_ld(int rt, int n, int sz, int rex) {              /* guest register n, zero-extended, into rt */
