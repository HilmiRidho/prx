+static u64 jemb_stack[8192];
+#endif
+
+/* ------------------------------------------------------------ AArch64 encoders */
+static inline void E(u32 w) { *jcur++ = w; }
+#define SFB(sf) ((sf) ? 0x80000000u : 0u)
+
