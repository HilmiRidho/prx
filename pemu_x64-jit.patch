+    switch (sz) {
+    case 8: a_ldst_u(3, 1, rt, RCPU, off); break;
+    case 4: a_ldst_u(2, 1, rt, RCPU, off); break;
+    case 2: a_ldst_u(1, 1, rt, RCPU, off); break;
