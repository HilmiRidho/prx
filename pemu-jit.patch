+    out.append(0xD53B4200 | 27)                                                                 # mrs x27, nzcv
+    for r in range(0, 31, 1):
+        out.append(0xF9000000 | (0x900 // 8 + r) << 10 | 29 << 5 | r)                           # str xr,[x29,#0x900+8r]
+    for q in range(8):
