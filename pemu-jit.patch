+    out += [0xD2800000 | 0xa80 << 5 | 2, 0xD2800000 | 64 << 5 | 8, 0xD4000001]
+    out += [0xD2800000 | 0, 0xD2800000 | 93 << 5 | 8, 0xD4000001]
