diff -ruN a/src/pemu_x64.c b/src/pemu_x64.c
--- a/src/pemu_x64.c
+++ b/src/pemu_x64.c
@@ -2139,6 +2139,17 @@
     case 0x88: case 0x89: { int sz = op & 1 ? opsz : 1; modrm(c, &in, &m, 0); wrm(c, &in, &m, sz, getr(c, m.reg, sz, in.rex)); break; }
     case 0x8A: case 0x8B: { int sz = op & 1 ? opsz : 1; modrm(c, &in, &m, 0); setr(c, m.reg, sz, in.rex, rdm(c, &in, &m, sz)); break; }
     case 0x8D: { in.seg = 0; modrm(c, &in, &m, 0); if (!m.ismem) goto bad; setr(c, m.reg, opsz, in.rex, m.ea); break; }
+    case 0x8C: {                                    /* mov r/m16, Sreg: the selectors a Linux x86_64 user process sees (Wine reads them at startup) */
+        static const u16 sel[6] = { 0 /*es*/, 0x33 /*cs*/, 0x2b /*ss*/, 0 /*ds*/, 0 /*fs*/, 0 /*gs*/ };
+        modrm(c, &in, &m, 0);
+        int sr = m.reg & 7; if (sr > 5) goto bad;
+        wrm(c, &in, &m, m.ismem ? 2 : opsz, sel[sr]);   /* a register destination is zero-extended to the operand size */
+        break; }
+    case 0x8E: {                                    /* mov Sreg, r/m16: flat model, so loading es/ss/ds/fs/gs is accepted and ignored (fs/gs bases come from arch_prctl) */
+        modrm(c, &in, &m, 0);
+        int sr = m.reg & 7; if (sr == 1 || sr > 5) goto bad;      /* cs cannot be loaded */
+        (void) rdm(c, &in, &m, 2);
+        break; }
     case 0x8F: { modrm(c, &in, &m, 0); u64 v = pop(c); if (m.ismem && (m.rm == RSP)) {} wrm(c, &in, &m, 8, v); break; }
     case 0x90:
         if (rexB) { u64 t = c->r[8]; c->r[8] = c->r[RAX]; c->r[RAX] = t; }
diff -ruN a/tests/pemu_x64/seg.c b/tests/pemu_x64/seg.c
--- a/tests/pemu_x64/seg.c
+++ b/tests/pemu_x64/seg.c
@@ -0,0 +1,24 @@
+/* mov r/m, Sreg and mov Sreg, r/m: the selector values of a Linux x86_64 process, zero extension, and that loading is accepted. */
+#include <stdio.h>
+#include <stdint.h>
+
+int main(void) {
+    uint16_t m[6]; uint64_t r64, r32, r16;
+    __asm__ volatile("movw %%es, %0" : "=m"(m[0]));
+    __asm__ volatile("movw %%cs, %0" : "=m"(m[1]));
+    __asm__ volatile("movw %%ss, %0" : "=m"(m[2]));
+    __asm__ volatile("movw %%ds, %0" : "=m"(m[3]));
+    __asm__ volatile("movw %%fs, %0" : "=m"(m[4]));
+    __asm__ volatile("movw %%gs, %0" : "=m"(m[5]));
+    printf("es=%x cs=%x ss=%x ds=%x fs=%x gs=%x\n", m[0], m[1], m[2], m[3], m[4], m[5]);
+    r64 = ~0ULL; __asm__ volatile("mov %%cs, %%rax" : "+a"(r64));
+    r32 = ~0ULL; __asm__ volatile("mov %%cs, %%eax" : "+a"(r32));
+    r16 = ~0ULL; __asm__ volatile("mov %%cs, %%ax" : "+a"(r16));
+    printf("rax=%llx eax=%llx ax=%llx\n", (unsigned long long) r64, (unsigned long long) r32, (unsigned long long) r16);
+    uint16_t z = 0;
+    __asm__ volatile("mov %0, %%ds" :: "r"(z));
+    __asm__ volatile("movw %0, %%es" :: "m"(z));
+    __asm__ volatile("movw %%ds, %0" : "=m"(m[3]));
+    printf("after load ds=%x\n", m[3]);
+    return 0;
+}
diff -ruN a/tests/pemu_x64/seg.expect b/tests/pemu_x64/seg.expect
--- a/tests/pemu_x64/seg.expect
+++ b/tests/pemu_x64/seg.expect
@@ -0,0 +1,3 @@
+es=0 cs=33 ss=2b ds=0 fs=0 gs=0
+rax=33 eax=33 ax=ffffffffffff0033
+after load ds=0
