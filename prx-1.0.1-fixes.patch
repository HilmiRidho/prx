+# rpath ROOT GUESTPATH [nofollow]
+# Print the host path of GUESTPATH inside ROOT, resolving symbolic links as if
+# ROOT were "/": absolute links stay inside ROOT and ".." cannot climb out of it.
+# Every write into a rootfs goes through this, so a rootfs symlink such as
+# /var/lib/dbus/machine-id -> /etc/machine-id can never redirect a write to the
+# host. With "nofollow" the last component is not resolved.
+rpath() {
+local root="${1%/}" rest="$2" nf="${3:-}" cur="" comp link n=0
+while :; do
+rest="${rest#"${rest%%[!/]*}"}"
+[ -n "$rest" ] || break
+comp="${rest%%/*}"
+if [ "$comp" = "$rest" ]; then rest=""; else rest="${rest#*/}"; fi
+case "$comp" in
+.) continue ;;
+..) cur="${cur%/*}"; continue ;;
+esac
+if [ -L "$root$cur/$comp" ] && { [ -n "$rest" ] || [ "$nf" != nofollow ]; }; then
+n=$((n+1))
+if [ "$n" -gt 40 ]; then echo "prx: error: too many symbolic links in $2" >&2; return 1; fi
+link="$(readlink "$root$cur/$comp")" || return 1
+case "$link" in
+/*) cur=""; rest="$link${rest:+/$rest}" ;;
+*)  rest="$link${rest:+/$rest}" ;;
+esac
+else
+cur="$cur/$comp"
+fi
+done
+printf '%s\n' "$root$cur"
+}
+rwfile() {
+local h
+h="$(rpath "$1" "$2")" || exit 1
+wfile "$h" "$3"
+}
+valid_ipv4() {
+local re='^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$' i
+[[ "$1" =~ $re ]] || return 1
+for i in 1 2 3 4; do [ "$((10#${BASH_REMATCH[i]}))" -le 255 ] || return 1; done
+return 0
+}
+# clean_dns LIST: keep only IPv4 addresses (separators: ':' , ',' ';' or blanks).
+# The shim only speaks IPv4 DNS and stores the list colon-separated.
+clean_dns() {
+local -a toks=() parts=()
+local tok d out="" ok
+read -r -a toks <<<"$(printf '%s' "$1" | tr ',;' '  ')"
+for tok in ${toks[@]+"${toks[@]}"}; do
+case "$tok" in
+*:*)
+IFS=: read -r -a parts <<<"$tok"
+ok=1
+for d in "${parts[@]}"; do valid_ipv4 "$d" || ok=0; done
+if [ "$ok" = 1 ]; then
+for d in "${parts[@]}"; do out="${out:+$out:}$d"; done
+else
+warn "ignoring DNS server '$tok' (IPv6 is not supported)"
+fi ;;
+*)
+if valid_ipv4 "$tok"; then out="${out:+$out:}$tok"
+else warn "ignoring invalid DNS server '$tok'"
+fi ;;
+esac
+done
+echo "${out:-8.8.8.8:1.1.1.1}"
 }
