#!/data/data/com.termux/files/usr/bin/bash

# 1. Kill any existing instances safely
pkill -f termux-x11
pulseaudio --kill 2>/dev/null

# 2. Start PulseAudio server
pulseaudio --start --load="module-native-protocol-tcp auth-ip-acl=127.0.0.1 auth-anonymous=1"

# 3. Start Termux:X11 server
termux-x11 :0 -ac &

# 5. Wait briefly for servers to initialize
sleep 2

# 7. Login to PRoot with shared temporary directories
prx login trixie --no-root-id -b $PREFIX/tmp/.X11-unix:/tmp/.X11-unix -b /vendor:/vendor -b /system:/system -b /odm:/odm -b /apex:/apex -b /dev/mali0:/dev/mali0 -b /sdcard:/sdcard --trace
