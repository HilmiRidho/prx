 static int tmpgen(char*t, int suffix, int flags, int isdir) {
     size_t n = strlen(t);
     if ((size_t) suffix>n || n-(size_t) suffix<6 || memcmp(t+n-suffix-6, "XXXXXX", 6) != 0) return (int) fail(EINVAL);
@@ -108,6 +124,53 @@
 EXP int mkstemps64(char*t, int s) {
     return tmpgen(t, s, 0, 0);
 }
+EXP int mkostemps(char*t, int s, int f) {
+    return tmpgen(t, s, f, 0);
+}
+EXP int mkostemps64(char*t, int s, int f) {
+    return tmpgen(t, s, f, 0);
+}
+/* glibc's shm_open/shm_unlink open "/dev/shm/NAME" through internal calls that
+   bypass this shim and land in the host's /dev/shm (missing on Android); route
+   them through the translated open/unlink. Name rules follow glibc: leading
+   slashes are skipped, the rest must be non-empty and contain no '/'. */
+static int shm_path(const char*name, char*out) {
+    while (*name == '/') name++;
+    size_t n = strlen(name);
+    if (!n || (n == 1 && name[0] == '.') || (n == 2 && name[0] == '.' && name[1] == '.')) return (int) fail(EINVAL);
+    for (size_t i = 0; i<n; i++) if (name[i] == '/') return (int) fail(EINVAL);
+    if (n+10 >= PM) return (int) fail(ENAMETOOLONG);
+    memcpy(out, "/dev/shm/", 9);
+    memcpy(out+9, name, n+1);
+    return 0;
+}
+EXP int shm_open(const char*name, int oflag, int mode) {
+    char b[PM];
+    if (shm_path(name, b)<0) return-1;
+    return do_open(AT_FDCWD, b, oflag|O_NOFOLLOW|O_CLOEXEC, mode);
+}
+EXP int shm_unlink(const char*name) {
+    char b[PM];
+    if (shm_path(name, b)<0) return-1;
+    return unlink(b);
+}
+/* ftok and setmntent read a path through glibc-internal calls. */
+EXP int ftok(const char*p, int id) {
+    static int(*f)(const char*, int);
+    char bb[PM];
+    const char*h;
+    if (tr(AT_FDCWD, p, bb, 1, &h)<0) return-1;
+    if (!f) f = nextsym("ftok");
+    return f(h, id);
+}
+EXP void*setmntent(const char*p, const char*m) {
+    static void*(*f)(const char*, const char*);
+    char bb[PM];
+    const char*h;
+    if (tr(AT_FDCWD, p, bb, 1, &h)<0) return NULL;
+    if (!f) f = nextsym("setmntent");
+    return f(h, m);
+}
 /* glibc's own tmpfile() opens "/tmp" through an internal call that bypasses
    this shim and lands in the host's /tmp; build it from the translated mkstemp. */
 static void*do_tmpfile(void) {
diff -ruN -x .tmp -x '*.so' prx-orig/src/shim/pwdb.h prx-main/src/shim/pwdb.h
--- prx-orig/src/shim/pwdb.h	2026-11-01 18:40:48.556565465 +0000
+++ prx-main/src/shim/pwdb.h	2026-11-01 18:42:08.142809281 +0000
@@ -515,3 +515,132 @@
     for (int i = 0; i<c && i<room; i++) groups[i] = tmp[i];
     return room<c ? -1 : c;
 }
+/* getservby*() and getprotoby*() read /etc/services and /etc/protocols through
+   glibc-internal calls, so they would see the host's files (Android has none).
+   Parse the guest's files here; fall back to glibc when there is no match. */
+struct prx_servent { char*name; char**aliases; int port; char*proto; };
+struct prx_protoent { char*name; char**aliases; int proto; };
+static char sv_pool[1536], *sv_al[12];
+static struct prx_servent sv_se;
+static struct prx_protoent sv_pe;
+static char*sv_dup(const char*s, size_t n, size_t*used) {
+    if (*used+n+1 > sizeof sv_pool) return NULL;
+    char*d = sv_pool+*used;
+    memcpy(d, s, n);
+    d[n] = 0;
+    *used += n+1;
+    return d;
+}
+static int sv_num(const char*s, size_t n, int*out) {
+    if (!n || n>9) return 0;
+    int v = 0;
+    for (size_t i = 0; i<n; i++) {
+        if (s[i]<'0' || s[i]>'9') return 0;
+        v = v*10+(s[i]-'0');
+    }
+    *out = v;
+    return 1;
+}
+/* mode: 0 service by name, 1 service by port (host order), 2 protocol by name,
+   3 protocol by number. Returns 1 and fills sv_se / sv_pe on a match. */
+static int sv_find(int mode, const char*name, int num, const char*proto) {
+    long n;
+    char*buf = read_rel_all(mode<2 ? "/etc/services" : "/etc/protocols", &n);
+    if (!buf) return 0;
+    int found = 0;
+    for (char*l = buf; *l && !found; ) {
+        char*e = l;
+        while (*e && *e != '\n') e++;
+        char sv = *e;
+        *e = 0;
+        char*t[12];
+        size_t tl[12];
+        int k = 0;
+        for (char*c = l; *c && *c != '#' && k<12; ) {
+            while (*c == ' ' || *c == '\t' || *c == '\r') c++;
+            if (!*c || *c == '#') break;
+            t[k] = c;
+            while (*c && *c != ' ' && *c != '\t' && *c != '\r' && *c != '#') c++;
+            tl[k] = (size_t)(c-t[k]);
+            k++;
+        }
+        if (k >= 2) {
+            int port = 0, ok = 0;
+            size_t pl = tl[1];
+            const char*pr = NULL;
+            size_t prl = 0;
+            if (mode<2) {
+                size_t i = 0;
+                while (i<pl && t[1][i] != '/') i++;
+                if (i<pl && sv_num(t[1], i, &port)) {
+                    pr = t[1]+i+1;
+                    prl = pl-i-1;
+                    ok = 1;
+                }
+                if (ok && proto && (strlen(proto) != prl || memcmp(proto, pr, prl) != 0)) ok = 0;
+            } else ok = sv_num(t[1], pl, &port);
+            if (ok) {
+                int hit = 0;
+                if (mode == 1 || mode == 3) hit = (port == num);
+                else for (int i = 0; i<k && !hit; i++) {
+                    if (i == 1) continue;
+                    hit = (strlen(name) == tl[i] && memcmp(name, t[i], tl[i]) == 0);
+                }
+                if (hit) {
+                    size_t used = 0;
+                    char*nm = sv_dup(t[0], tl[0], &used);
+                    char*pp = mode<2 ? sv_dup(pr, prl, &used) : NULL;
+                    int na = 0, bad = !nm || (mode<2 && !pp);
+                    for (int i = 2; i<k && !bad; i++) {
+                        char*a = sv_dup(t[i], tl[i], &used);
+                        if (!a) bad = 1;
+                        else sv_al[na++] = a;
+                    }
+                    if (!bad) {
+                        sv_al[na] = NULL;
+                        if (mode<2) {
+                            sv_se.name = nm;
+                            sv_se.aliases = sv_al;
+                            sv_se.port = (int)(((port&0xff)<<8) | ((port>>8)&0xff));
+                            sv_se.proto = pp;
+                        } else {
+                            sv_pe.name = nm;
+                            sv_pe.aliases = sv_al;
+                            sv_pe.proto = port;
+                        }
+                        found = 1;
+                    }
+                }
+            }
+        }
+        *e = sv;
+        l = *e ? e+1 : e;
+    }
+    free(buf);
+    return found;
+}
+EXP void*getservbyname(const char*name, const char*proto) {
+    static void*(*real)(const char*, const char*);
+    if (name && g_rl && sv_find(0, name, 0, proto)) return &sv_se;
+    if (!real) real = nextsym("getservbyname");
+    return real(name, proto);
+}
+EXP void*getservbyport(int port, const char*proto) {
+    static void*(*real)(int, const char*);
+    int hp = ((port&0xff)<<8) | ((port>>8)&0xff);
+    if (g_rl && sv_find(1, 0, hp&0xffff, proto)) return &sv_se;
+    if (!real) real = nextsym("getservbyport");
+    return real(port, proto);
+}
+EXP void*getprotobyname(const char*name) {
+    static void*(*real)(const char*);
+    if (name && g_rl && sv_find(2, name, 0, 0)) return &sv_pe;
+    if (!real) real = nextsym("getprotobyname");
+    return real(name);
+}
+EXP void*getprotobynumber(int num) {
+    static void*(*real)(int);
+    if (g_rl && sv_find(3, 0, num, 0)) return &sv_pe;
+    if (!real) real = nextsym("getprotobynumber");
+    return real(num);
+}
diff -ruN -x .tmp -x '*.so' prx-orig/src/shim/resolve.h prx-main/src/shim/resolve.h
--- prx-orig/src/shim/resolve.h	2026-11-01 18:40:48.556582432 +0000
+++ prx-main/src/shim/resolve.h	2026-11-01 18:41:53.609452007 +0000
@@ -304,3 +304,25 @@
     if (resolve_name(name, ip)) return real(ip);
     return r;
 }
+/* Reentrant variants: same /etc/hosts and DNS fallback as gethostbyname. */
+static int ghbn_fallback(int rc, void**res, const char*name, char*ip) {
+    if (rc == 34 || (rc == 0 && *res)) return 0;
+    if (!g_rl || !name || is_numeric(name)) return 0;
+    return resolve_name(name, ip);
+}
+EXP int gethostbyname_r(const char*name, void*ret, char*buf, size_t len, void**res, int*herr) {
+    static int(*real)(const char*, void*, char*, size_t, void**, int*);
+    if (!real) real = nextsym("gethostbyname_r");
+    int rc = real(name, ret, buf, len, res, herr);
+    char ip[32];
+    if (ghbn_fallback(rc, res, name, ip)) return real(ip, ret, buf, len, res, herr);
+    return rc;
+}
+EXP int gethostbyname2_r(const char*name, int af, void*ret, char*buf, size_t len, void**res, int*herr) {
+    static int(*real)(const char*, int, void*, char*, size_t, void**, int*);
+    if (!real) real = nextsym("gethostbyname2_r");
+    int rc = real(name, af, ret, buf, len, res, herr);
+    char ip[32];
+    if (af == 2 && ghbn_fallback(rc, res, name, ip)) return real(ip, af, ret, buf, len, res, herr);
+    return rc;
+}
diff -ruN -x .tmp -x '*.so' prx-orig/tests/shim_fs.c prx-main/tests/shim_fs.c
--- prx-orig/tests/shim_fs.c	1970-01-01 00:00:00.000000000 +0000
+++ prx-main/tests/shim_fs.c	2026-11-01 18:42:54.148807351 +0000
@@ -0,0 +1,64 @@
+/* Run with the shim preloaded: shim_fs ROOT
+ * ROOT is the fake rootfs given as PRX_ROOTFS; it must hold etc/services (prxsvc 4242/tcp
+ * prxalias), etc/protocols (prxproto 250 PRXP), etc/hosts (10.9.8.7 prxhost), etc/mtab
+ * (prxdev ...), etc/prxmarker, dev/shm/ and tmp/. Each check fails when glibc reads the
+ * HOST file instead of the guest one. Exit status is a bitmask of failed checks. */
+#define _GNU_SOURCE
+#include <dirent.h>
+#include <fcntl.h>
+#include <mntent.h>
+#include <netdb.h>
+#include <arpa/inet.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/ipc.h>
+#include <sys/mman.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+static int raw_exists(const char *p) { return syscall(SYS_access, p, 0) == 0; }
+
+int main(int argc, char **argv) {
+    int bad = 0;
+    char b[512];
+    if (argc < 2) return 255;
+    struct servent *s = getservbyname("prxalias", "tcp");
+    if (!s || ntohs(s->s_port) != 4242 || strcmp(s->s_name, "prxsvc")) bad |= 1;
+    s = getservbyport(htons(4242), "tcp");
+    if (!s || strcmp(s->s_name, "prxsvc")) bad |= 2;
+    struct protoent *p = getprotobyname("prxproto");
+    if (!p || p->p_proto != 250) bad |= 4;
+    p = getprotobynumber(250);
+    if (!p || strcmp(p->p_name, "prxproto")) bad |= 8;
+    struct hostent h, *r = NULL;
+    char hb[1024];
+    int he;
+    if (gethostbyname_r("prxhost", &h, hb, sizeof hb, &r, &he) != 0 || !r) bad |= 16;
+    int fd = shm_open("/prxshm", O_CREAT | O_RDWR, 0600);
+    snprintf(b, sizeof b, "%s/dev/shm/prxshm", argv[1]);
+    if (fd < 0 || !raw_exists(b)) bad |= 32;
+    if (fd >= 0) close(fd);
+    shm_unlink("/prxshm");
+    if (raw_exists(b)) bad |= 32;
+    char tn[] = "/tmp/prxXXXXXX.txt";
+    fd = mkostemps(tn, 4, 0);
+    snprintf(b, sizeof b, "%s%s", argv[1], tn);
+    if (fd < 0 || !raw_exists(b)) bad |= 64;
+    if (fd >= 0) close(fd);
+    unlink(tn);
+    if (ftok("/etc/prxmarker", 1) == (key_t)-1) bad |= 128;
+    FILE *m = setmntent("/etc/mtab", "r");
+    int found = 0;
+    if (m) {
+        struct mntent *e;
+        while ((e = getmntent(m))) if (!strcmp(e->mnt_fsname, "prxdev")) found = 1;
+        endmntent(m);
+    }
+    if (!found) bad |= 256;
+    struct dirent **nl;
+    int n = scandirat(AT_FDCWD, "/etc", &nl, 0, 0);
+    found = 0;
+    for (int i = 0; i < n; i++) if (!strcmp(nl[i]->d_name, "prxmarker")) found = 1;
+    if (!found) bad |= 512;
+    return bad & 255 ? (bad & 255) : (bad ? 1 : 0);
+}
diff -ruN -x .tmp -x '*.so' prx-orig/tests/smoke.sh prx-main/tests/smoke.sh
--- prx-orig/tests/smoke.sh	2026-11-01 18:40:48.558627507 +0000
