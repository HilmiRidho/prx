+                    if (after) { fprintf(stderr, "pemu:   next  %s", ln); after = 0; }
+                    if (sscanf(ln, "%llx-%llx", &lo, &hi) == 2 && t >= lo && t < hi) { fprintf(stderr, "pemu:   prev  %spemu:   tail  %s", prev, ln); after = 1; }
+                    memcpy(prev, ln, sizeof prev);
+                }
+                fclose(m2);
+            }
+        }
