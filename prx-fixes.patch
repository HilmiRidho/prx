diff -ruN a/prx b/prx
--- a/prx	2026-11-04 13:07:47.000000000 +0000
+++ b/prx	2026-11-04 13:30:43.079607724 +0000
@@ -665,7 +665,7 @@
 esac
 shift 2 ;;
 -w|--workdir) [ $# -ge 2 ] || die "-w requires a directory"; case "$2" in /*) wd="$2"; wdset=1 ;; *) die "-w requires an absolute guest path: $2" ;; esac; shift 2 ;;
--e|--env)     [ $# -ge 2 ] || die "-e requires KEY=VALUE"; extra_envs+=("$2"); shift 2 ;;
+-e|--env)     [ $# -ge 2 ] || die "-e requires KEY=VALUE"; case "$2" in [A-Za-z_]*=*) ;; *) die "-e requires KEY=VALUE (got '$2')" ;; esac; case "${2%%=*}" in *[!A-Za-z0-9_]*) die "-e: invalid variable name '${2%%=*}'" ;; esac; extra_envs+=("$2"); shift 2 ;;
 --no-root-id) fake=0; shift ;;
 --no-seccomp) seccomp=0; shift ;;
 --trace)      trace=1; shift ;;
diff -ruN a/src/shim/seccomp.h b/src/shim/seccomp.h
--- a/src/shim/seccomp.h	2026-11-04 13:07:47.000000000 +0000
+++ b/src/shim/seccomp.h	2026-11-04 13:30:43.079350894 +0000
@@ -16,6 +16,9 @@
 static int g_seccomp = 1;
 #ifdef PRX_NO_SECCOMP
 #define SECCOMP_ON() 0
+/* No override in this build: declare libc's, used by fake_proc_stat() (procfs.h).
+   Without it clang (C99+) rejects the implicit declaration and the shim fails to build. */
+extern int sched_getaffinity(int, size_t, void*);
 static void seccomp_init(void) {
 }
 static long seccomp_nnp(int(*f)(int, unsigned long, unsigned long, unsigned long, unsigned long), unsigned long a2, unsigned long a3, unsigned long a4, unsigned long a5) {
diff -ruN a/tests/smoke.sh b/tests/smoke.sh
--- a/tests/smoke.sh	2026-11-04 13:07:47.000000000 +0000
+++ b/tests/smoke.sh	2026-11-04 13:30:52.589091612 +0000
@@ -25,7 +25,7 @@
 ok "man page documents the environment variables"
 # the shim compiles standalone, with and without seccomp support
 "${CC:-cc}" -fsyntax-only -w -ffreestanding "$HERE/src/prx.c" 2>/dev/null && ok "shim compiles standalone"
-"${CC:-cc}" -fsyntax-only -Wall -Wno-unused-function -ffreestanding -DPRX_NO_SECCOMP "$HERE/src/prx.c" 2>/dev/null && ok "shim compiles with -DPRX_NO_SECCOMP"
+"${CC:-cc}" -fsyntax-only -Wall -Werror=implicit-function-declaration -Wno-unused-function -ffreestanding -DPRX_NO_SECCOMP "$HERE/src/prx.c" 2>/dev/null && ok "shim compiles with -DPRX_NO_SECCOMP"
 
 # default data directory (XDG)
 "$PRX" build >/dev/null 2>&1 || fail "prx build"
@@ -64,6 +64,12 @@
 if "$PRX" login t1 -b "$T:rel" 2>"$T/err"; then fail "relative guest bind accepted"; fi
 grep -q 'absolute' "$T/err" && ok "login rejects relative guest bind path"
 
+# -e without KEY=VALUE must be an error (env would run the word as a program)
+if "$PRX" login t1 -e FOO 2>"$T/err"; then fail "-e without '=' accepted"; fi
+grep -q 'KEY=VALUE' "$T/err" && ok "login rejects -e without KEY=VALUE" || fail "login rejects -e without KEY=VALUE"
+if "$PRX" login t1 -e 'A-B=1' 2>"$T/err"; then fail "-e with invalid name accepted"; fi
+grep -q 'KEY=VALUE\|invalid variable name' "$T/err" && ok "login rejects -e with an invalid variable name" || fail "login rejects -e with an invalid variable name"
+
 # bind validation: too long / ambiguous ':'
 long="/$(printf 'x%.0s' $(seq 1 1100))"
 if "$PRX" login t1 -b "$T:$long" 2>"$T/err"; then fail "overlong bind accepted"; fi
