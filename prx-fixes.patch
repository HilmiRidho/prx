 cmd_remove() {
+local yes=0
+while [ $# -gt 0 ]; do
+case "$1" in
+-y|--yes) yes=1; shift ;;
+--) shift; break ;;
+-*) die "Unknown option for 'remove': $1" ;;
+*) break ;;
+esac
+done
 [ $# -ge 1 ] || { usage; exit 1; }
 local name="$1" d; chk "$name"; d="$(rootdir "$name")"; [ -d "$d" ] || die "Rootfs not found: $name"
+if [ "$yes" = 0 ] && [ -t 0 ]; then
+local ans=""
+printf "prx: delete container '%s' (%s) and everything in it? [y/N] " "$name" "$d" >&2
+read -r ans || ans=""
+case "$ans" in y|Y|yes|YES) ;; *) die "Aborted; nothing was removed" ;; esac
+fi
